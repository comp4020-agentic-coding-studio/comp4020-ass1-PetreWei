---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Every page in the site, in header order. Home is the empty filename (the
// base URL itself); the Index tab sits last, as a table of contents.
const PAGES = [
  { label: "Home", file: "" },
  { label: "Circle", file: "circle.html" },
  { label: "Chords", file: "chords.html" },
  { label: "Colour", file: "colour.html" },
  { label: "Index", file: "site-index.html" },
] as const;

// Matched on the emitted filename rather than the whole path, because the
// deployed pathname carries the repo's base prefix. Exactly one tab must come
// back true — a spec test asserts that, since marking two would silently look
// like the first one being current.
function isCurrent(file: string): boolean {
  const path = Astro.url.pathname;
  if (file === "") {
    return (
      path === "/" ||
      path.endsWith("/index.html") ||
      path === base ||
      path === base.replace(/\/$/, "")
    );
  }
  return path.endsWith(`/${file}`);
}

const tabs = PAGES.map((page) => ({
  label: page.label,
  href: `${base}${page.file}`,
  current: isCurrent(page.file),
}));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav class="tabs" aria-label="Primary">
        {
          tabs.map((tab) => (
            <a class="tab" href={tab.href} aria-current={tab.current ? "page" : undefined}>
              {tab.label}
            </a>
          ))
        }
      </nav>
    </header>
    <slot />
    <footer>
      <h2>References</h2>
      <ul class="references">
        <li>
          Mr Mars, <a href="https://warrenmars.com/visual_art/theory/colour_wheel/music_colours/music_colours.htm">"Musical Colour Wheel"</a>
          — the 24-key colour scheme this site borrows for its highlights.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Chromesthesia">"Chromesthesia"</a>
          — background on the real sound-to-colour phenomenon.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Circle_of_fifths">"Circle of fifths"</a>
          — background on the music theory this diagram is built from.
        </li>
        <li>
          Musicca, <a href="https://www.musicca.com/circle-of-fifths">"Circle of Fifths"</a>
          — reference for showing key signatures on the wheel and listing each
          key's diatonic chords with roman numerals.
        </li>
        <li>
          Chromatone, <a href="https://fifths.chromatone.center/">"Circle of Fifths"</a>
          — reference for keeping every key's colour visible permanently and
          showing the selected key's detail at the centre of the wheel.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Roman_numeral_analysis">"Roman numeral analysis"</a>
          — the triads, roman numerals, scale-degree names and chord qualities
          shown on the wheel and in the chord table.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/12_equal_temperament">"12 equal temperament"</a>
          — the A440 tuning the played frequencies are derived from, and the
          octave numbering printed on the keyboard's white keys.
        </li>
      </ul>
      {/* Deliberately few external citations, and no inline links in the prose
      on top of them: CI's link check crawls every distinct external URL on the
      site concurrently, and Wikipedia rate-limits (429) a burst of them from a
      shared CI IP. Ten distinct Wikipedia URLs turned the check red; the two
      here, plus the two already above, stay near the count that has always
      passed. Prefer naming a concept in the prose over adding a link to it. */}
    </footer>
  </body>
</html>
