---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const homeHref = base;
const theoryHref = `${base}theory.html`;
const isTheory =
  Astro.url.pathname.endsWith("/theory.html") || Astro.url.pathname.endsWith("/theory");
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav class="tabs" aria-label="Primary">
        <a class="tab" href={homeHref} aria-current={isTheory ? undefined : "page"}>Home</a>
        <a class="tab" href={theoryHref} aria-current={isTheory ? "page" : undefined}>Theory</a>
      </nav>
    </header>
    <slot />
    <footer>
      <h2>References</h2>
      <ul class="references">
        <li>
          Mr Mars, <a href="https://warrenmars.com/visual_art/theory/colour_wheel/music_colours/music_colours.htm">"Musical Colour Wheel"</a>
          — the 24-key colour scheme this site borrows for its highlights.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Chromesthesia">"Chromesthesia"</a>
          — background on the real sound-to-colour phenomenon.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Circle_of_fifths">"Circle of fifths"</a>
          — background on the music theory this diagram is built from.
        </li>
        <li>
          Musicca, <a href="https://www.musicca.com/circle-of-fifths">"Circle of Fifths"</a>
          — reference for showing key signatures on the wheel and listing each
          key's diatonic chords with roman numerals.
        </li>
        <li>
          Chromatone, <a href="https://fifths.chromatone.center/">"Circle of Fifths"</a>
          — reference for keeping every key's colour visible permanently and
          showing the selected key's detail at the centre of the wheel.
        </li>
      </ul>
    </footer>
  </body>
</html>
