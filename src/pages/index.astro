---
import Layout from "../layouts/Layout.astro";
import { KEYS, PIANO_KEYS, getKeyColor } from "../lib/circleOfFifths.ts";

const MAJOR_RADIUS_PERCENT = 38;
const MINOR_RADIUS_PERCENT = 21;

function withPosition<T extends { index: number }>(key: T, radiusPercent: number) {
  const angleRad = ((key.index * 360) / KEYS.length) * (Math.PI / 180);
  return {
    ...key,
    left: 50 + radiusPercent * Math.sin(angleRad),
    top: 50 - radiusPercent * Math.cos(angleRad),
  };
}

const positionedMajorKeys = KEYS.map((key) => ({
  ...withPosition(key, MAJOR_RADIUS_PERCENT),
  color: getKeyColor(key.index, "major"),
}));

const positionedMinorKeys = KEYS.map((key) => ({
  ...withPosition(key, MINOR_RADIUS_PERCENT),
  color: getKeyColor(key.index, "minor"),
}));

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const theoryHref = `${base}theory.html`;

const whiteKeyCount = PIANO_KEYS.filter((key) => !key.isBlack).length;
---

<Layout title="Chromesthesia Circle of Fifths">
  <main>
    <h1>Chromesthesia Circle of Fifths</h1>
    <p data-testid="intro">
      New to music theory? You don't need to know any of it to start: click
      a key on the outer ring for its major chord, or the inner ring for its
      relative minor. Each key has its own colour, and its two neighbours on
      the circle light up too — they share six of its seven scale notes,
      which is why moving around this circle is always the smallest possible
      step. Curious where the colours and the theory come from?
      <a href={theoryHref}>Read the theory page →</a>
    </p>
    <section class="circle-layout">
      <div class="circle-column">
        <div class="playback-mode" role="group" aria-label="Playback style">
          <button type="button" class="mode-button" data-playback-mode="arpeggio" aria-pressed="true">
            Arpeggio
          </button>
          <button type="button" class="mode-button" data-playback-mode="chord" aria-pressed="false">
            Chord
          </button>
        </div>
        <div class="circle-wrapper" role="group" aria-label="Circle of fifths keys">
          {
            positionedMajorKeys.map((key) => (
              <button
                type="button"
                class="key-button"
                data-key={key.name}
                data-index={key.index}
                data-mode="major"
                aria-pressed="false"
                aria-label={
                  key.index === 6
                    ? "F sharp major, or G flat major"
                    : `${key.name} major`
                }
                style={`--btn-left: ${key.left}%; --btn-top: ${key.top}%; --key-color: ${key.color.css}; --key-text-color: ${key.color.textColor};`}
              >
                {key.name}
              </button>
            ))
          }
          {
            positionedMinorKeys.map((key) => (
              <button
                type="button"
                class="key-button key-button-minor"
                data-key={key.relativeMinorName}
                data-index={key.index}
                data-mode="minor"
                aria-pressed="false"
                aria-label={
                  key.index === 6
                    ? "D sharp minor, or E flat minor"
                    : `${key.relativeMinorName} minor`
                }
                style={`--btn-left: ${key.left}%; --btn-top: ${key.top}%; --key-color: ${key.color.css}; --key-text-color: ${key.color.textColor};`}
              >
                {key.relativeMinorName}
              </button>
            ))
          }
        </div>
        <div class="piano-keyboard-scroll">
          <div class="piano-keyboard" data-testid="piano-keyboard" aria-hidden="true">
            {
              PIANO_KEYS.map((key) => (
                <div
                  class={`piano-key ${key.isBlack ? "piano-key-black" : "piano-key-white"}`}
                  data-pitch-class={key.pitchClass}
                  data-octave={key.octave}
                  style={`--key-left: ${(key.whiteIndex / whiteKeyCount) * 100}%;`}
                />
              ))
            }
          </div>
        </div>
        <ul class="legend">
          <li class="legend-item">
            <span class="legend-swatch legend-swatch-selected" aria-hidden="true" />
            key you picked
          </li>
          <li class="legend-item">
            <span class="legend-swatch legend-swatch-dominant" aria-hidden="true" />
            one step clockwise (the "dominant")
          </li>
          <li class="legend-item">
            <span class="legend-swatch legend-swatch-subdominant" aria-hidden="true" />
            one step counter-clockwise (the "subdominant")
          </li>
          <li class="legend-item">
            outer ring = major, inner ring = its relative minor
          </li>
        </ul>
      </div>
      <section class="key-info" data-testid="key-info" aria-live="polite">
        <p data-testid="key-info-placeholder">
          Pick any key above to hear it played and see exactly what changes
          as you move to its neighbors.
        </p>
        <p class="key-info__name" data-field="name"></p>
        <p class="key-info__scale" data-field="scale"></p>
        <p class="key-info__signature" data-field="signature"></p>
        <p class="key-info__color" data-field="color-name"></p>
        <p class="key-info__dominant" data-field="dominant-diff"></p>
        <p class="key-info__subdominant" data-field="subdominant-diff"></p>
      </section>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
