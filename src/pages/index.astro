---
import Layout from "../layouts/Layout.astro";
import { KEYS, PIANO_KEYS, getAccidentalBadgeText, getKeyColor } from "../lib/circleOfFifths.ts";

const BADGE_RADIUS_PERCENT = 49.5;
// The major ring is shrunk (outer 40, not all the way to the badges at
// 49.5) so its roman numeral can sit past its coloured band, on the plain
// background, the same way the minor ring's numeral already sits below
// MINOR_RING.inner — see MAJOR_NUMERAL_RADIUS_PERCENT below.
const MAJOR_RING = { inner: 29, outer: 40 };
const MINOR_RING = { inner: 15, outer: 26 };
const MAJOR_LABEL_RADIUS_PERCENT = (MAJOR_RING.inner + MAJOR_RING.outer) / 2;
const MINOR_LABEL_RADIUS_PERCENT = (MINOR_RING.inner + MINOR_RING.outer) / 2;
// Sits in the gap between the (now shrunk) major ring and the accidental
// badges at BADGE_RADIUS_PERCENT — outside the coloured band, at the same
// radius the numeral used to sit at when it was still inside that band.
const MAJOR_NUMERAL_RADIUS_PERCENT = 43;
// Sits inside the hole/minor-ring gap, below MINOR_RING.inner, so the
// numeral never sits on top of the coloured minor-ring band or its name.
const MINOR_NUMERAL_RADIUS_PERCENT = 13;
const HOLE_RADIUS_PERCENT = 11;
const INNER_BORDER_RADIUS_PERCENT = (MINOR_RING.outer + MAJOR_RING.inner) / 2;
// How many wedge-widths the unified neighbour-highlight sector spans:
// subdominant + selected + dominant.
const SECTOR_SPAN_WEDGES = 3;

function polarXY(angleDeg: number, radiusPercent: number): [number, number] {
  const a = (angleDeg * Math.PI) / 180;
  return [50 + radiusPercent * Math.sin(a), 50 - radiusPercent * Math.cos(a)];
}

function polarPoint(angleDeg: number, radiusPercent: number) {
  const [x, y] = polarXY(angleDeg, radiusPercent);
  return `${x}% ${y}%`;
}

function wedgeArcs(index: number, gapDeg: number) {
  const step = 360 / KEYS.length;
  const start = index * step - step / 2 + gapDeg / 2;
  const end = index * step + step / 2 - gapDeg / 2;
  const n = 8;
  return {
    n,
    outerAngle: (i: number) => start + ((end - start) * i) / n,
    innerAngle: (i: number) => end - ((end - start) * i) / n,
  };
}

// Renders a wedge as a clip-path polygon rather than an SVG path so it can
// stay a plain <button> (paint and hit-testing both follow clip-path), and
// as percentages rather than pixels so it stays responsive.
function wedgePolygon(index: number, innerRadius: number, outerRadius: number, gapDeg = 2) {
  const { n, outerAngle, innerAngle } = wedgeArcs(index, gapDeg);
  const outer = Array.from({ length: n + 1 }, (_, i) => polarPoint(outerAngle(i), outerRadius));
  const inner = Array.from({ length: n + 1 }, (_, i) => polarPoint(innerAngle(i), innerRadius));
  return `polygon(${[...outer, ...inner].join(", ")})`;
}

// The identical arc geometry as sectorPolygon's arcs, but spanning several
// wedge-widths centred on `centerIndex` rather than just one, so the
// neighbour-highlight outline can trace one continuous sector rather than
// per-wedge borders.
function sectorArcs(centerIndex: number, spanWedges: number, gapDeg: number) {
  const step = 360 / KEYS.length;
  const start = centerIndex * step - (spanWedges * step) / 2 + gapDeg / 2;
  const end = centerIndex * step + (spanWedges * step) / 2 - gapDeg / 2;
  const n = 24;
  return {
    n,
    outerAngle: (i: number) => start + ((end - start) * i) / n,
    innerAngle: (i: number) => end - ((end - start) * i) / n,
  };
}

// One closed SVG path (numeric, viewBox 0-100) spanning the selected key and
// its two neighbours, from the minor ring's inner edge to the major ring's
// outer edge, so a single stroke can outline that whole 6-cell region
// instead of six separate per-wedge borders.
function sectorBorderPath(
  centerIndex: number,
  innerRadius: number,
  outerRadius: number,
  spanWedges = SECTOR_SPAN_WEDGES,
  gapDeg = 2,
) {
  const { n, outerAngle, innerAngle } = sectorArcs(centerIndex, spanWedges, gapDeg);
  const outer = Array.from({ length: n + 1 }, (_, i) => polarXY(outerAngle(i), outerRadius));
  const inner = Array.from({ length: n + 1 }, (_, i) => polarXY(innerAngle(i), innerRadius));
  const [first, ...rest] = [...outer, ...inner];
  return `M ${first[0]} ${first[1]} ${rest.map(([x, y]) => `L ${x} ${y}`).join(" ")} Z`;
}

function withPosition<T extends { index: number }>(key: T, radiusPercent: number) {
  const angleRad = ((key.index * 360) / KEYS.length) * (Math.PI / 180);
  return {
    ...key,
    left: 50 + radiusPercent * Math.sin(angleRad),
    top: 50 - radiusPercent * Math.cos(angleRad),
  };
}

// "Am", "Em", ... — and for the one enharmonic wedge, "D♯m / E♭m".
function minorLabel(relativeMinorName: string) {
  return relativeMinorName.split(" / ").map((name) => `${name}m`).join(" / ");
}

// Splits an enharmonic pair like "F♯ / G♭" into ["G♭", "F♯"] — flat first,
// concatenated with no "/" and no space (renders as "G♭F♯") — so the two
// spellings read as one compact label at the single enharmonic wedge
// instead of overflowing it; returns null for every other, single-spelling
// key name.
function enharmonicParts(name: string): [string, string] | null {
  if (!name.includes(" / ")) return null;
  const [sharp, flat] = name.split(" / ");
  return [flat, sharp];
}

const positionedMajorKeys = KEYS.map((key) => {
  const numeralPos = withPosition(key, MAJOR_NUMERAL_RADIUS_PERCENT);
  return {
    ...withPosition(key, MAJOR_LABEL_RADIUS_PERCENT),
    numeralLeft: numeralPos.left,
    numeralTop: numeralPos.top,
    color: getKeyColor(key.index, "major"),
    clipPath: wedgePolygon(key.index, MAJOR_RING.inner, MAJOR_RING.outer),
    nameParts: enharmonicParts(key.name),
  };
});

const positionedMinorKeys = KEYS.map((key) => {
  const numeralPos = withPosition(key, MINOR_NUMERAL_RADIUS_PERCENT);
  return {
    ...withPosition(key, MINOR_LABEL_RADIUS_PERCENT),
    numeralLeft: numeralPos.left,
    numeralTop: numeralPos.top,
    color: getKeyColor(key.index, "minor"),
    clipPath: wedgePolygon(key.index, MINOR_RING.inner, MINOR_RING.outer),
    nameParts: enharmonicParts(minorLabel(key.relativeMinorName)),
  };
});

const positionedBadges = KEYS.map((key) => ({
  ...withPosition(key, BADGE_RADIUS_PERCENT),
  text: getAccidentalBadgeText(key),
}));

const positionedSectors = KEYS.map((key) => ({
  index: key.index,
  path: sectorBorderPath(key.index, MINOR_RING.inner, MAJOR_RING.outer),
}));

const whiteKeyCount = PIANO_KEYS.filter((key) => !key.isBlack).length;
---

<Layout title="Chromesthesia Circle of Fifths">
  <main>
    <h1>Chromesthesia Circle of Fifths</h1>
    <p data-testid="intro">
      Click a key on the outer ring for its major chord, or the inner ring for
      its relative minor. A thin outline traces its three related keys on
      each ring, labelled with their roman numeral — click a row in the chord
      table below to hear it on its own.
    </p>
    <section class="circle-layout">
      <div class="circle-column">
        <div class="playback-mode" role="group" aria-label="Playback style">
          <button type="button" class="mode-button" data-playback-mode="arpeggio" aria-pressed="true">
            Arpeggio
          </button>
          <button type="button" class="mode-button" data-playback-mode="chord" aria-pressed="false">
            Chord
          </button>
        </div>
        <div class="circle-wrapper" role="group" aria-label="Circle of fifths keys">
          {
            positionedMajorKeys.map((key) => (
              <>
                <button
                  type="button"
                  class="key-wedge"
                  data-key={key.name}
                  data-index={key.index}
                  data-mode="major"
                  aria-pressed="false"
                  aria-label={
                    key.index === 6
                      ? "F sharp major, or G flat major"
                      : `${key.name} major`
                  }
                  style={`--key-color: ${key.color.css}; --wedge-clip: ${key.clipPath};`}
                >
                  <span
                    class={`wedge-name ${key.nameParts ? "wedge-name-enharmonic" : ""}`}
                    style={`--label-left: ${key.left}%; --label-top: ${key.top}%;`}
                  >
                    {key.nameParts ? (<><span class="wedge-name-part">{key.nameParts[0]}</span><span class="wedge-name-part">{key.nameParts[1]}</span></>) : (key.name)}
                  </span>
                </button>
                {/* Sits outside the button's own clip-path (a clipped element
                clips its descendants too), so this has to be a sibling, not a
                child, or it would be clipped away and invisible. */}
                <span
                  class="wedge-numeral"
                  data-testid="wedge-numeral"
                  data-index={key.index}
                  data-mode="major"
                  style={`--label-left: ${key.numeralLeft}%; --label-top: ${key.numeralTop}%;`}
                />
              </>
            ))
          }
          {
            positionedMinorKeys.map((key) => (
              <>
                <button
                  type="button"
                  class="key-wedge key-wedge-minor"
                  data-key={key.relativeMinorName}
                  data-index={key.index}
                  data-mode="minor"
                  aria-pressed="false"
                  aria-label={
                    key.index === 6
                      ? "D sharp minor, or E flat minor"
                      : `${key.relativeMinorName} minor`
                  }
                  style={`--key-color: ${key.color.css}; --wedge-clip: ${key.clipPath};`}
                >
                  <span
                    class={`wedge-name ${key.nameParts ? "wedge-name-enharmonic" : ""}`}
                    style={`--label-left: ${key.left}%; --label-top: ${key.top}%;`}
                  >
                    {key.nameParts ? (<><span class="wedge-name-part">{key.nameParts[0]}</span><span class="wedge-name-part">{key.nameParts[1]}</span></>) : (minorLabel(key.relativeMinorName))}
                  </span>
                </button>
                {/* This numeral sits below MINOR_RING.inner, off the coloured
                band entirely, so it also needs to be unclipped (see above) —
                and, since it's no longer painted over a coloured wedge, it
                needs a dark ink instead of the wedge's light --wedge-ink. */}
                <span
                  class="wedge-numeral"
                  data-testid="wedge-numeral"
                  data-index={key.index}
                  data-mode="minor"
                  style={`--label-left: ${key.numeralLeft}%; --label-top: ${key.numeralTop}%;`}
                />
              </>
            ))
          }
          {
            positionedSectors.map((sector) => (
              <svg
                class="sector-border"
                data-sector-index={sector.index}
                viewBox="0 0 100 100"
                preserveAspectRatio="none"
                aria-hidden="true"
              >
                <path d={sector.path} />
              </svg>
            ))
          }
          {
            positionedBadges.map((badge) => (
              <span
                class="key-signature-badge"
                aria-hidden="true"
                style={`--btn-left: ${badge.left}%; --btn-top: ${badge.top}%;`}
              >
                {badge.text}
              </span>
            ))
          }
          <div
            class="circle-inner-border"
            aria-hidden="true"
            style={`width: ${INNER_BORDER_RADIUS_PERCENT * 2}%; height: ${INNER_BORDER_RADIUS_PERCENT * 2}%;`}
          />
          <div
            class="circle-center"
            data-testid="circle-center"
            aria-live="polite"
            style={`width: ${HOLE_RADIUS_PERCENT * 2}%;`}
          >
            <p data-testid="key-info-placeholder">Pick a key</p>
            <p class="circle-center-name" data-field="name"></p>
            <p class="circle-center-colour" data-field="colour"></p>
          </div>
        </div>
        <section class="key-info" data-testid="key-info" aria-live="polite" hidden>
          <table class="chord-table chord-table-playable" data-testid="chord-table">
            <thead>
              <tr>
                <th scope="col">Chord</th>
                <th scope="col">Function</th>
                <th scope="col">Root</th>
              </tr>
            </thead>
            <tbody data-testid="chord-table-body"></tbody>
          </table>
        </section>
        <div class="piano-keyboard-scroll">
          <div class="piano-keyboard" data-testid="piano-keyboard" role="group" aria-label="Two-octave piano keyboard">
            {
              PIANO_KEYS.map((key) => (
                <button
                  type="button"
                  class={`piano-key ${key.isBlack ? "piano-key-black" : "piano-key-white"}`}
                  data-pitch-class={key.pitchClass}
                  data-octave={key.octave}
                  aria-label={
                    key.flatLabel
                      ? `${key.label} / ${key.flatLabel} ${key.octave}`
                      : `${key.label} ${key.octave}`
                  }
                  style={`--key-left: ${(key.whiteIndex / whiteKeyCount) * 100}%;`}
                >
                  {key.flatLabel ? (
                    <span class="piano-key-label piano-key-label-black">
                      <span>{key.label}</span>
                      <span>{key.flatLabel}</span>
                    </span>
                  ) : (
                    <span class="piano-key-label">{key.label}{key.octave}</span>
                  )}
                </button>
              ))
            }
          </div>
        </div>
        <div class="happy-birthday" data-testid="happy-birthday">
          <button type="button" class="happy-birthday-button" data-testid="happy-birthday-button" disabled>
            Play Happy Birthday
          </button>
          <p class="happy-birthday-caption">Plays "Happy Birthday" transposed into the key you've picked.</p>
        </div>
      </div>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
