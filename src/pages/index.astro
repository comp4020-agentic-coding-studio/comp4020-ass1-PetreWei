---
import Layout from "../layouts/Layout.astro";
import { KEYS, PIANO_KEYS } from "../lib/circleOfFifths.ts";

const RADIUS_PERCENT = 38;

const positionedKeys = KEYS.map((key, i) => {
  const angleRad = ((i * 360) / KEYS.length) * (Math.PI / 180);
  return {
    ...key,
    left: 50 + RADIUS_PERCENT * Math.sin(angleRad),
    top: 50 - RADIUS_PERCENT * Math.cos(angleRad),
  };
});
---

<Layout title="Circle of Fifths">
  <header>
    <nav aria-label="Primary">
      <a href="./">Home</a>
    </nav>
  </header>
  <main>
    <h1>Circle of Fifths</h1>
    <p data-testid="intro">
      New to music theory? You don't need to know anything to start — click
      any letter on the circle to hear that key's chord, then watch its two
      neighbors light up. Each neighbor sounds almost the same, because it's
      only one note away from the key you picked. That's the entire reason
      this diagram is drawn as a circle instead of a straight line: every
      step around it is the smallest possible change.
    </p>
    <section class="circle-layout">
      <div class="circle-column">
        <div class="circle-wrapper" role="group" aria-label="Circle of fifths keys">
          {
            positionedKeys.map((key) => (
              <button
                type="button"
                class="key-button"
                data-key={key.name}
                data-index={key.index}
                aria-pressed="false"
                aria-label={
                  key.index === 6
                    ? "F sharp major, or G flat major"
                    : `${key.name} major`
                }
                style={`--btn-left: ${key.left}%; --btn-top: ${key.top}%;`}
              >
                {key.name}
              </button>
            ))
          }
        </div>
        <div class="piano-keyboard" data-testid="piano-keyboard" aria-hidden="true">
          {
            PIANO_KEYS.map((key) => (
              <div
                class={`piano-key ${key.isBlack ? "piano-key-black" : "piano-key-white"}`}
                data-pitch-class={key.pitchClass}
                style={`--key-left: ${(key.whiteIndex / 7) * 100}%;`}
              />
            ))
          }
        </div>
        <ul class="legend">
          <li class="legend-item">
            <span class="legend-swatch legend-swatch-selected" aria-hidden="true" />
            key you picked
          </li>
          <li class="legend-item">
            <span class="legend-swatch legend-swatch-dominant" aria-hidden="true" />
            one step clockwise (the "dominant")
          </li>
          <li class="legend-item">
            <span class="legend-swatch legend-swatch-subdominant" aria-hidden="true" />
            one step counter-clockwise (the "subdominant")
          </li>
        </ul>
      </div>
      <section class="key-info" data-testid="key-info" aria-live="polite">
        <p data-testid="key-info-placeholder">
          Pick any key above to hear it played and see exactly what changes
          as you move to its neighbors.
        </p>
        <p class="key-info__name" data-field="name"></p>
        <p class="key-info__scale" data-field="scale"></p>
        <p class="key-info__signature" data-field="signature"></p>
        <p class="key-info__dominant" data-field="dominant-diff"></p>
        <p class="key-info__subdominant" data-field="subdominant-diff"></p>
      </section>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
