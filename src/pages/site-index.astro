---
import Layout from "../layouts/Layout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const contents = [
  {
    label: "Home",
    file: "",
    summary:
      "The interactive wheel itself: click a key for its chord, read its roman numerals, play its chords on the keyboard, and hear Happy Birthday in that key.",
    topics: ["the wheel", "chord table", "keyboard", "Happy Birthday"],
  },
  {
    label: "Circle",
    file: "circle.html",
    summary:
      "Why twelve keys form a ring, and what the ♯/♭ badges, the inner ring and the thin outline on the wheel each mean.",
    topics: [
      "what a fifth is",
      "key signatures",
      "relative minors",
      "closely-related keys",
    ],
  },
  {
    label: "Chords",
    file: "chords.html",
    summary:
      "How a key's seven chords are built, why they carry roman numerals, and how the notes are tuned and played back.",
    topics: [
      "triads",
      "diatonic chords",
      "scale-degree functions",
      "roman numerals",
      "octave numbers",
      "equal temperament and A440",
      "transposition",
    ],
  },
  {
    label: "Colour",
    file: "colour.html",
    summary:
      "What chromesthesia actually is, why these particular colours are a designed system rather than measured data, and the full list of 24.",
    topics: ["chromesthesia", "Mr Mars' colour wheel", "all 24 key colours"],
  },
];
---

<Layout title="Index — Chromesthesia Circle of Fifths">
  <main>
    <h1>Index</h1>
    <p>
      Four pages: the wheel you can play with, and three that explain what it's
      showing you. Everything here stays at the level of fundamentals.
    </p>

    <ul class="site-index-list">
      {
        contents.map((entry) => (
          <li class="site-index-entry">
            <h2><a href={`${base}${entry.file}`}>{entry.label}</a></h2>
            <p>{entry.summary}</p>
            <p class="site-index-topics">{entry.topics.join(" · ")}</p>
          </li>
        ))
      }
    </ul>

    {/* Every source for the whole site, gathered here rather than repeated in a
    footer on all five pages. Kept deliberately short: CI's link check crawls
    each distinct external URL once per run, and a burst of them gets
    rate-limited from a shared runner IP — so name concepts in the prose and
    cite them here, rather than linking inline as well. */}
    <section class="theory-section references-section">
      <h2>References</h2>
      <ul class="references">
        <li>
          Mr Mars, <a href="https://web.archive.org/web/20241214000856/https://warrenmars.com/visual_art/theory/colour_wheel/music_colours/music_colours.htm">"Musical Colour Wheel"</a>
          (archived) — the 24-key colour scheme this site borrows for its
          highlights. Cited via the Internet Archive: the original host refuses
          automated requests, and a snapshot can't rot.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Chromesthesia">"Chromesthesia"</a>
          — background on the real sound-to-colour phenomenon.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Circle_of_fifths">"Circle of fifths"</a>
          — background on the music theory this diagram is built from.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/Roman_numeral_analysis">"Roman numeral analysis"</a>
          — the triads, roman numerals, scale-degree names and chord qualities
          shown on the wheel and in the chord table.
        </li>
        <li>
          Wikipedia, <a href="https://en.wikipedia.org/wiki/12_equal_temperament">"12 equal temperament"</a>
          — the A440 tuning the played frequencies are derived from, and the
          octave numbering printed on the keyboard's white keys.
        </li>
        <li>
          Musicca, <a href="https://www.musicca.com/circle-of-fifths">"Circle of Fifths"</a>
          — reference for showing key signatures on the wheel and listing each
          key's diatonic chords with roman numerals.
        </li>
        <li>
          Chromatone, <a href="https://fifths.chromatone.center/">"Circle of Fifths"</a>
          — reference for keeping every key's colour visible permanently and
          showing the selected key's detail at the centre of the wheel.
        </li>
      </ul>
    </section>
  </main>
</Layout>
