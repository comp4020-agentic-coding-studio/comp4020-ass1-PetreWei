---
import { pageHref } from "../lib/i18n.ts";
import type { Locale } from "../lib/i18n.ts";
import { stringsFor } from "../i18n/index.ts";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = stringsFor(locale);
const base = import.meta.env.BASE_URL;

const entries = t.siteIndex.entries.map((entry) => ({
  ...entry,
  label: t.nav[entry.page],
  href: pageHref(base, locale, entry.page),
}));

// Citations are rendered as text, NOT as links, and the whole site now has no
// external <a href> at all. CI's link check crawls every distinct external URL
// on every run; third-party hosts we do not control have turned it red twice
// (a 403 from bot protection, then a 429 from rate limiting), and neither
// failure said anything true about this site. Text citations keep the
// attribution and the URL a reader can copy, with nothing for a crawler to
// follow. `url` is deliberately a plain string, not an href.
//
// This is also why each `url` can now be the canonical source. The Mr Mars
// citation previously had to point at an Internet Archive snapshot purely
// because that host 403s crawlers; as text it is never fetched, so the real
// URL is cited instead.
//
// Titles stay English in every locale by bibliographic convention (wrapped in
// lang="en" so a screen reader switches voice — WCAG 3.1.2, Language of Parts).
const references = [
  {
    publisher: "Mr Mars",
    title: "Musical Colour Wheel",
    url: "https://warrenmars.com/visual_art/theory/colour_wheel/music_colours/music_colours.htm",
    note: t.siteIndex.references.mrMars,
  },
  {
    publisher: "Wikipedia",
    title: "Chromesthesia",
    url: "https://en.wikipedia.org/wiki/Chromesthesia",
    note: t.siteIndex.references.chromesthesia,
  },
  {
    publisher: "Wikipedia",
    title: "Circle of fifths",
    url: "https://en.wikipedia.org/wiki/Circle_of_fifths",
    note: t.siteIndex.references.circleOfFifths,
  },
  {
    publisher: "Wikipedia",
    title: "Roman numeral analysis",
    url: "https://en.wikipedia.org/wiki/Roman_numeral_analysis",
    note: t.siteIndex.references.romanNumerals,
  },
  {
    publisher: "Wikipedia",
    title: "12 equal temperament",
    url: "https://en.wikipedia.org/wiki/12_equal_temperament",
    note: t.siteIndex.references.equalTemperament,
  },
  {
    publisher: "Musicca",
    title: "Circle of Fifths",
    url: "https://www.musicca.com/circle-of-fifths",
    note: t.siteIndex.references.musicca,
  },
  {
    publisher: "Chromatone",
    title: "Circle of Fifths",
    url: "https://fifths.chromatone.center/",
    note: t.siteIndex.references.chromatone,
  },
];
---

<main>
  <h1>{t.siteIndex.h1}</h1>
  <p>{t.siteIndex.intro}</p>

  <ul class="site-index-list">
    {
      entries.map((entry) => (
        <li class="site-index-entry">
          <h2><a href={entry.href}>{entry.label}</a></h2>
          <p>{entry.summary}</p>
          <p class="site-index-topics">{entry.topics.join(" · ")}</p>
        </li>
      ))
    }
  </ul>

  {/* Every source for the whole site, gathered here rather than repeated in a
  footer on all five pages. Kept deliberately short: CI's link check crawls
  each distinct external URL once per run, and a burst of them gets
  rate-limited from a shared runner IP — so name concepts in the prose and
  cite them here, rather than linking inline as well. */}
  <section class="theory-section references-section">
    <h2>{t.siteIndex.referencesHeading}</h2>
    <ul class="references">
      {
        references.map((reference) => (
          <li>
            {reference.publisher}, <cite lang="en">"{reference.title}"</cite>
            {" "}{reference.note}
            {" "}<span class="reference-url" lang="en">{reference.url}</span>
          </li>
        ))
      }
    </ul>
  </section>
</main>
